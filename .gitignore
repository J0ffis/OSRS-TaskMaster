# Private, per-machine data: sync token, synced profiles and goals
server/data/

# RuneLite login session written by --insecure-write-credentials. It lives in
# %USERPROFILE%\.runelite, but never commit a copy that lands in the project by accident.
credentials.properties

# Build output
plugin/build/
plugin/.gradle/

# Sync service: installed packages and wrangler's local dev database and secrets
sync/node_modules/
sync/.wrangler/
sync/.dev.vars

# Local tooling and editor files
.claude/
.idea/
.vscode/
*.iml
*.log
Thumbs.db
