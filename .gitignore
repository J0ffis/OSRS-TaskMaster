# Private, per-machine data: sync token, synced profiles and goals
server/data/

# Private notes kept on this PC only (e.g. LAUNCH-PLAN.local.md)
*.local.md

# RuneLite login session written by --insecure-write-credentials. It lives in
# %USERPROFILE%\.runelite, but never commit a copy that lands in the project by accident.
credentials.properties

# Build output
plugin/build/
plugin/.gradle/
tools/game-icons/build/
tools/game-icons/.gradle/

# Sync service: installed packages and wrangler's local dev database and secrets
sync/node_modules/
sync/.dev.vars
# Wrangler writes a .wrangler folder wherever it runs; its cache holds location details from
# your connection (city, postcode, coordinates, ISP), so never commit one anywhere.
.wrangler/

# Local tooling and editor files
.claude/
.idea/
.vscode/
*.iml
*.log
Thumbs.db
