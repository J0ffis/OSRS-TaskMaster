# Keeps formatting consistent across editors (VS Code, IntelliJ and most others read this file).
# See https://editorconfig.org
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# Website: 2 spaces.
[*.{js,mjs,css,html,json,yml}]
indent_style = space
indent_size = 2

# PowerShell scripts: 2 spaces, and ASCII only (Windows PowerShell 5.1 misreads other
# characters in a script saved without a byte order mark).
[*.ps1]
indent_style = space
indent_size = 2
charset = latin1

# RuneLite plugin and local server: tabs, like RuneLite's own code.
[*.java]
indent_style = tab

[*.bat]
end_of_line = crlf

# Markdown uses two trailing spaces for line breaks.
[*.md]
trim_trailing_whitespace = false
