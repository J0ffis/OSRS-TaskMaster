# Line endings. Files are stored with LF in the repository; git picks the right ending on checkout.
* text=auto

# Windows batch files must have CRLF endings, or cmd.exe can misread them. This also applies to
# GitHub's "Download ZIP", which is how testers get the project.
*.bat text eol=crlf
*.cmd text eol=crlf

# The Gradle wrapper script runs on Linux/macOS (e.g. the Plugin Hub's build) and needs LF.
gradlew text eol=lf

# Saved suggestion snapshots are compared as text on every OS: keep them LF everywhere.
*.snapshot text eol=lf

# Binary files: never touch their bytes.
*.png binary
*.jpg binary
*.jar binary
